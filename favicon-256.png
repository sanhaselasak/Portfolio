<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="100%" height="100%">
  <defs>
    <linearGradient id="goldTop" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fdf4d0"/>
      <stop offset="45%" stop-color="#e0c36b"/>
      <stop offset="100%" stop-color="#8a6821"/>
    </linearGradient>
    <linearGradient id="goldSide" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#c69a3a"/>
      <stop offset="60%" stop-color="#7e5c18"/>
      <stop offset="100%" stop-color="#4a3712"/>
    </linearGradient>
    <linearGradient id="purpleFace" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#8752bd"/>
      <stop offset="50%" stop-color="#522b82"/>
      <stop offset="100%" stop-color="#291544"/>
    </linearGradient>
    <linearGradient id="purpleBevel" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#a179d1"/>
      <stop offset="70%" stop-color="#3b1e61"/>
      <stop offset="100%" stop-color="#180d29"/>
    </linearGradient>
    <filter id="dropShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="8" stdDeviation="8" flood-color="#180d29" flood-opacity="0.45"/>
    </filter>
  </defs>
  
  <g filter="url(#dropShadow)" transform="translate(10, 10) scale(0.9)">
    <!-- Top S Segment (Gold & Purple Beveled) -->
    <!-- Outer gold framework -->
    <path d="M 95 25 L 145 25 L 175 55 L 175 85 L 145 115 L 105 115 L 85 95 L 125 95 L 145 75 L 145 55 L 125 35 L 95 35 Z" fill="url(#goldTop)" stroke="#522b82" stroke-width="1.5"/>
    
    <!-- Top S Inner Purple Ribbon -->
    <path d="M 65 25 L 95 25 L 125 55 L 125 75 L 105 95 L 65 95 L 45 75 L 45 55 Z" fill="url(#purpleFace)" stroke="url(#goldSide)" stroke-width="1.5"/>
    <path d="M 45 55 L 65 35 L 95 35 L 125 65 L 105 85 L 65 85 Z" fill="url(#purpleBevel)" opacity="0.6"/>

    <!-- Interlocking Lower S Segment -->
    <path d="M 105 175 L 55 175 L 25 145 L 25 115 L 55 85 L 95 85 L 115 105 L 75 105 L 55 125 L 55 145 L 75 165 L 105 165 Z" fill="url(#goldSide)" stroke="#3b1e61" stroke-width="1.5"/>
    
    <path d="M 135 175 L 105 175 L 75 145 L 75 125 L 95 105 L 135 105 L 155 125 L 155 145 Z" fill="url(#purpleFace)" stroke="url(#goldTop)" stroke-width="1.5"/>
    <path d="M 155 145 L 135 165 L 105 165 L 75 135 L 95 115 L 135 115 Z" fill="url(#goldTop)" opacity="0.8"/>

    <!-- Center Converging Intersection Node -->
    <polygon points="90,90 110,90 120,100 110,110 90,110 80,100" fill="url(#goldTop)" stroke="#291544" stroke-width="1.5"/>
  </g>
</svg>
